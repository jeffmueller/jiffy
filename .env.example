# Jiffy configuration.
# Copy this file to .env and fill in at least one provider key:
#
#   cp .env.example .env
#
# Jiffy searches every provider that has a key set and interleaves the results.
# With no keys set the app still runs, but every search comes back empty.

# Klipy — https://partner.klipy.com/api-keys
# Test keys allow 100 calls/hour; production access is a form in the partner panel.
KLIPY_APP_KEY=

# Giphy — https://developers.giphy.com
# Beta keys allow 100 calls/hour; production keys require an upgrade request.
GIPHY_API_KEY=

# Host port to publish Jiffy on. The container always listens on 3000 internally.
JIFFY_PORT=3003

# Container timezone (only affects log timestamps).
TZ=UTC

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Requests per minute allowed against the search/autocomplete/trending/proxy
# endpoints. This exists to stop anyone who can reach the port from burning
# through your provider quota — worth keeping low, since a Giphy or Klipy test
# key only allows 100 calls/hour in total. Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=60

# Set to "true" only when Jiffy sits behind a reverse proxy that sets
# X-Forwarded-For (the bundled nginx config does). Then the limit applies per
# client IP. Left false, every caller shares one bucket, so the limit acts as a
# single global cap — the safe default when the container is exposed directly,
# because otherwise anyone could spoof the header to get an unlimited bucket.
TRUST_PROXY_HEADERS=false
