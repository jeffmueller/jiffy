# Jiffy configuration.
# Copy this file to .env and fill in at least one provider key:
#
#   cp .env.example .env
#
# Jiffy searches every provider that has a key set and interleaves the results.
# With no keys set the app still runs, but every search comes back empty.

# Klipy — https://partner.klipy.com/api-keys
KLIPY_APP_KEY=

# Giphy — https://developers.giphy.com (beta keys are capped at 100 calls/hour)
GIPHY_API_KEY=

# Host port to publish Jiffy on. The container always listens on 3000 internally.
JIFFY_PORT=3003

# Container timezone (only affects log timestamps).
TZ=UTC
